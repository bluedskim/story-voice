# Local auth DB
data/story_voice.db
data/story_voice.db-*
data/.session_secret

# Local voice data (never commit recordings)
data/voice/*
!data/voice/README.md
!data/voice/default/
data/voice/default/*
!data/voice/default/README.md
!data/voice/default/default-narration-source.wav
data/voice/history/
data/recordings/
recordings/

# Generated story audio
data/audio/*
!data/audio/.gitkeep
!data/audio/default/
data/audio/default/*
!data/audio/default/.gitkeep

# Per-user voice and generated audio
data/users/

# Generation temp files
out/

# Runtime symlink / manifest (regenerated by serve.py)
web/audio
web/catalog.json
*.m4a
*.wav
!web/**/*.wav
!data/voice/default/default-narration-source.wav

# Python
.venv/
__pycache__/
*.py[cod]
.Python
.mise.toml

# macOS
.DS_Store

